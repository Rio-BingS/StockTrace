[Unit]
Description=StockTrace SQLite online backup (sqlite3 .backup + rotate)
After=network-online.target

[Service]
Type=oneshot
User=www
Group=www
# 可选：STOCKTRACE_DB / BACKUP_DIR / BACKUP_KEEP / BACKUP_RSYNC_TARGET / BACKUP_POST_HOOK
EnvironmentFile=-/etc/stocktrace/backup.env
ExecStart=/opt/stocktrace/deploy/stocktrace-backup.sh
# 备份是 IO 密集的低优先级任务，别和 Web/调度抢资源
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# ---- 沙箱（SEC-10）：只读整个系统，仅备份目录可写；源库只读即可（.backup 走在线备份 API）
# 注意 SQLite 读 WAL 库需要能写 -shm，所以 backend/ 仍需可写
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0027
ReadWritePaths=/opt/stocktrace/backend /var/backups/stocktrace
