# Copy to /etc/stocktrace/env and fill in values. Do not commit real secrets.
# 本文件列出代码读取的全部环境变量（测试会校验：这里的每个变量都必须被代码读取，
# 代码里新增的 os.environ 变量也必须补到这里）。带 # 的为可选项，值即默认值。

# ---- Django 基础（必填） ----
# 生产拒绝示例占位符与 < 50 字符的 key（SEC-04），生成：
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# API Key 加密密钥（与 SECRET_KEY 解耦，强烈建议配置；逗号分隔，第一个加密、其余仅解密）
# 生成：python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 首次配置或轮换后执行 manage.py rotate_api_keys，见 DEPLOY.md「密钥管理」
STOCKTRACE_FERNET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=stocktrace.yumeat.cc.cd,127.0.0.1
# collectstatic 输出目录（默认仓库根下 staticfiles/，即 /opt/stocktrace/staticfiles；须与 nginx /static/ alias 一致）
# STOCKTRACE_STATIC_ROOT=/opt/stocktrace/staticfiles

# ---- HTTPS / 来源校验（SEC-03/05） ----
# 受信来源（CORS 与 CSRF_TRUSTED_ORIGINS 共用，含 https://，逗号分隔；默认如下）
# STOCKTRACE_TRUSTED_ORIGINS=https://stocktrace.yumeat.cc.cd
# Session/CSRF Cookie 仅 HTTPS 发送（缺省 = DEBUG 取反；本地 http 调 admin 时设 0）
# STOCKTRACE_SECURE_COOKIES=1
# HSTS 秒数（默认 0 关闭；确认全站 HTTPS 稳定后再开，如 31536000）
# STOCKTRACE_HSTS_SECONDS=0
# STOCKTRACE_HSTS_INCLUDE_SUBDOMAINS=0
# /api/ 写请求要求浏览器带 X-Requested-With 头（默认 1；跨站 Origin 无论如何都拒绝）
# STOCKTRACE_CSRF_REQUIRE_HEADER=1

# ---- Gunicorn（gunicorn_config.py） ----
# 1H2G 建议 1；AI 后台任务已落库（AiJob），多 worker 也不会丢任务或重复执行
# GUNICORN_WORKERS=1
# GUNICORN_THREADS=2
# GUNICORN_LOGLEVEL=info
# 处理 N 个请求后回收 worker（内存泄漏兜底；0 = 不回收）
# GUNICORN_MAX_REQUESTS=20000
# GUNICORN_MAX_REQUESTS_JITTER=1000

# ---- 调度 ----
# 调度总开关（0 = Web 内与 run_scheduler 都不启动调度，/api/health/ 也不再检查调度心跳）
# STOCKTRACE_SCHEDULER=1
# 是否在 Web 进程内启动调度器（兼容旧部署；默认 0，生产用 stocktrace-scheduler.service）
# STOCKTRACE_RUN_SCHEDULER_IN_WEB=0
# 收盘后探测器扫描开关（0 = 17:15 探测器任务直接跳过）
# STOCKTRACE_DETECTOR=1
# 锁/心跳文件目录（两个 systemd 单元已用 Environment= 设为 /run/stocktrace）
# STOCKTRACE_RUN_DIR=/run/stocktrace
# 单独覆盖锁文件 / 心跳文件路径（缺省在 STOCKTRACE_RUN_DIR 下）
# STOCKTRACE_SCHEDULER_LOCK=/run/stocktrace/scheduler.lock
# STOCKTRACE_SCHEDULER_HEARTBEAT=/run/stocktrace/scheduler_heartbeat.json
# 心跳超过该秒数未更新，/api/health/ 判定调度器失联
# STOCKTRACE_HEARTBEAT_STALE_SECONDS=180

# ---- 数据库 ----
# SQLite 锁等待秒数（PERF-03）：调度写库与 Web 读并发时避免 "database is locked"
# STOCKTRACE_DB_TIMEOUT=20

# ---- 日志（REL-02） ----
# STOCKTRACE_LOGLEVEL=INFO
# 另写一份日志文件（Web 与调度建议分开，在各自 unit 里用 Environment= 设置）
# STOCKTRACE_LOG_FILE=

# ---- 上游与 AI ----
# 进程级 socket 默认超时（秒），兜底未显式传 timeout 的上游请求
# STOCKTRACE_UPSTREAM_TIMEOUT=30
# STOCKTRACE_LLM_TIMEOUT=60
# STOCKTRACE_AI_DAILY_LIMIT=100
# 同一只股票两次成功 AI 分析的最小间隔（秒），失败调用不计冷却
# STOCKTRACE_AI_STOCK_COOLDOWN=60
# AI 服务商 base_url：1 = 允许 http（仅本地开发）；主机白名单（逗号分隔，非空时只允许这些主机）
# AI_ALLOW_HTTP_BASE_URL=0
# AI_BASE_URL_ALLOWED_HOSTS=
# AI 并发上限（同步接口满了立即 429；后台任务按此上限跨 worker 排队）、
# LLM 跨重试总时长（秒，须小于 gunicorn timeout 120；后台任务租约 = 2×该值 + 60 秒）、重试次数
# STOCKTRACE_AI_MAX_CONCURRENCY=1
# STOCKTRACE_LLM_TOTAL_TIMEOUT=90
# STOCKTRACE_LLM_MAX_RETRIES=1
# 同步拉上游的市场接口总时限（秒，REL-05）；须小于 nginx proxy_read_timeout 120s
# 与前端 110s 超时，超时返回降级结果而非 504
# STOCKTRACE_REQUEST_DEADLINE=100
# 价格提醒 / 快照自检告警外发推送（Server酱兼容，POST {title, desp}）；留空只记本地
# STOCKTRACE_PUSH_URL=

# ---- 数据保留（天） ----
# AI_CALL_LOG_RETENTION_DAYS=90
# DETECTOR_SIGNAL_RETENTION_DAYS=600
# DETECTOR_RUN_RETENTION_DAYS=120
# 调参流水（DetectorTuneLog）永久保留，不受上面两项影响

# ---- 探测器复盘与自动调参 ----
# 在线自动调参总开关（默认关闭：只统计并记演练流水，不改维度配置）
# DETECTOR_AUTO_TUNE=0
# 自动调参的跨日累计窗口（自然日）
# DETECTOR_TUNE_WINDOW_DAYS=180
# 复盘兑现阈值系数 k：阈值 = k × σ20 × √5
# DETECTOR_REVIEW_SIGMA_K=1.0
# 每日板块信号上限（按强度截断，0 = 不截断；指数与自选股不截）
# DETECTOR_SECTOR_SIGNAL_CAP=10
# 成分池（沪深300+中证500）限速日线采集：单线程，每 N 秒最多拉一只（最少 5）
# POOL_FETCH_ENABLED=1
# POOL_FETCH_INTERVAL_SECONDS=20
# 回补窗口（自然日，400 ≈ 270 个交易日）与「已有数据就跳过」的根数门槛
# POOL_BACKFILL_CALENDAR_DAYS=400
# POOL_MIN_BARS=250
# 成分池日线数据源顺序（逗号分隔；默认新浪在前：境外东财不可达、腾讯无成交额）
# POOL_DAILY_SOURCES=sina,eastmoney,baostock,tencent
# 分钟 K 线（PERF-02；每日 02:30 分批清理更早的 MinuteBar）
# MINUTE_BAR_RETENTION_DAYS=120
# 市场日度快照（不可重新拉取；低于 400 按 400 处理，见 OPS-06）
# MARKET_SNAPSHOT_RETENTION_DAYS=600
